<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup rules, Android 11 and below (android:fullBackupContent).
     Keep in sync with data_extraction_rules.xml. Add here anything that is
     bound to this device/app instance (push token, credentials encrypted
     with a Keystore key that does not travel: CredentialStore.java). -->
<full-backup-content>
    <exclude domain="sharedpref" path="calaos_push.xml" />
    <exclude domain="sharedpref" path="calaos_credentials.xml" />
</full-backup-content>
