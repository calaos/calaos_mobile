<?xml version="1.0"?>
<!-- Merged into the main manifest for the release build type (sourceSets.release
     in build.gradle). Qt's Core module makes androiddeployqt insert
     WRITE_EXTERNAL_STORAGE into the main manifest; the app only uses app-private
     storage, so it is removed from the merged manifest. It cannot be removed from
     the main manifest itself: the marker and the inserted element would be
     duplicates in the same file. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        tools:node="remove" />
</manifest>
