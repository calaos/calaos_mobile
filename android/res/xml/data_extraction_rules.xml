<?xml version="1.0" encoding="utf-8"?>
<!-- Auto Backup / device-to-device transfer rules, Android 12+
     (android:dataExtractionRules). Keep in sync with backup_rules.xml. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="calaos_push.xml" />
        <exclude domain="sharedpref" path="calaos_credentials.xml" />
        <exclude domain="sharedpref" path="calaos_admin_bio.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="calaos_push.xml" />
        <exclude domain="sharedpref" path="calaos_credentials.xml" />
        <exclude domain="sharedpref" path="calaos_admin_bio.xml" />
    </device-transfer>
</data-extraction-rules>
